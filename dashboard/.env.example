# === Supabase Configuration ===
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# === Test Accounts ===
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# === Cloudflare R2 (Legacy Public URL) ===
NEXT_PUBLIC_R2_PUBLIC_URL=

# === Settings Encryption ===
SETTINGS_ENCRYPTION_KEY=your_32_character_encryption_key_here

# === Release Ops Worker Gateway ===
RELEASE_OPS_WORKER_TOKEN=your_worker_token_here

# === Release Ops Artifact Storage ===
RELEASE_OPS_ARTIFACT_BUCKET=release-ops-artifacts
RELEASE_OPS_APK_RETENTION_HOURS=24
RELEASE_OPS_WORKER_LEASE_SECONDS=300
RELEASE_OPS_MAX_EVENT_BYTES=4096

# === Cron Protection ===
CRON_SECRET=your_cron_secret_here
