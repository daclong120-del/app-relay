# === App Relay — Production Environment ===
# Copy this file as .env on the VPS at /root/app-relay/
# Both docker-compose.prod.yml services read it, so it must carry the dashboard
# credentials as well as the worker settings.

# --- Supabase (dashboard) -------------------------------------------------
# Required. Placeholder values ('mock', 'example', 'supabase.local', ...) are
# rejected: the API returns 503 rather than serving fabricated data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Worker authentication ------------------------------------------------
# One shared value, read under two names: the gateway validates
# RELEASE_OPS_WORKER_TOKEN, the worker presents WORKER_TOKEN.
# Minimum 24 characters. Generate with:
#   node -e "console.log('wrk_' + require('crypto').randomBytes(24).toString('hex'))"
RELEASE_OPS_WORKER_TOKEN=
WORKER_TOKEN=

# --- Dashboard access -----------------------------------------------------
# Optional. When set, only these addresses may sign in to the dashboard.
# When unset, any user account in the Supabase project may sign in.
APPRELAY_ADMIN_EMAILS=

# Optional. Comma-separated browser origins allowed to call the partner API.
# Leave empty for same-origin only.
APPRELAY_ALLOWED_ORIGINS=

# --- Worker ---------------------------------------------------------------
WORKER_NAME=app-relay-worker-01

# Must point at the real gateway route. /api/internal/worker/v1 does not exist.
GATEWAY_URL=https://your-dashboard-url.com/api/release-ops/worker/v1

# false = real ADB pipeline. true makes the worker report fabricated artifacts.
USE_FAKE_PIPELINE=false

MAX_PARALLEL_JOBS=1
POLL_INTERVAL_MS=5000
