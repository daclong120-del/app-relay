# === App Relay Worker — Production Environment ===
# Copy this file as .env on VPS at /root/app-relay/

# Worker identity
WORKER_NAME=app-relay-worker-01

# Dashboard API endpoint (public URL)
GATEWAY_URL=https://your-dashboard-url.com/api/internal/worker/v1

# Worker authentication token
WORKER_TOKEN=your-secret-worker-token

# Pipeline mode (false = real ADB pipeline)
USE_FAKE_PIPELINE=false

# Concurrency
MAX_PARALLEL_JOBS=1

# Polling interval (ms)
POLL_INTERVAL_MS=5000
