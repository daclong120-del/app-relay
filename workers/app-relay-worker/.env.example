# === Release Ops Worker Gateway ===
# Variable names must match src/config/env.ts: GATEWAY_URL and WORKER_TOKEN.
# (The previous RELEASE_OPS_API_URL / RELEASE_OPS_TOKEN names were never read.)
GATEWAY_URL=http://localhost:3000/api/release-ops/worker/v1

# Required, minimum 24 characters. Generate with:
#   node -e "console.log('wrk_' + require('crypto').randomBytes(24).toString('hex'))"
# Then either set the same value as RELEASE_OPS_WORKER_TOKEN on the dashboard,
# or register its sha256 hash in release_ops_worker_tokens.
# The worker refuses to start if this is unset, too short, or a known
# placeholder such as the old 'dev-worker-token-secret-key' default.
WORKER_TOKEN=

WORKER_ID=
WORKER_NAME=app-relay-worker-01
WORKER_CAPABILITIES=pull_apk
WORKER_VERSION=1.0.0

# === Worker Polling & Heartbeat ===
MAX_PARALLEL_JOBS=1
POLL_INTERVAL_MS=5000
WORKER_HEARTBEAT_INTERVAL_MS=30000
JOB_HEARTBEAT_INTERVAL_MS=10000

# === ADB / Android Device ===
ADB_PATH=adb
ADB_DEVICE_SERIAL=emulator-5554
ADB_SERVER_SOCKET=
EMULATOR_PATH=emulator
AVD_NAME=chpay
# false = emulator mo cua so GUI; true = chay ngam (-no-window)
HEADLESS=false
# Che do GPU khi chay co GUI (headless luon dung -gpu off).
# Phai set tuong minh: neu AVD co hw.gpu.enabled=no thi emulator chay nhung KHONG hien cua so.
#   swiftshader_indirect = render phan mem, chay duoc moi noi (bat buoc trong WSL vi khong co /dev/dri)
#   host                 = dung GPU that, nhanh hon, chi dung khi may co driver GPU
EMULATOR_GPU_MODE=swiftshader_indirect

# === APK Pull Pipeline ===
APK_WORK_DIR=./tmp
INSTALL_TIMEOUT_MS=180000
ADB_COMMAND_TIMEOUT_MS=30000
LISTING_TIMEOUT_MS=15000
MAX_JOB_BYTES=536870912
MIN_FREE_DISK_GB=5

# === Logging ===
LOG_LEVEL=info
