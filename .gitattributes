# Files that are executed inside Linux containers must keep LF endings.
# A CRLF checkout on Windows turns the shebang into `#!/bin/bash\r`, which the
# kernel cannot resolve — the script dies with exit 127 ("not found") and the
# error names the interpreter, not the invisible carriage return.
*.sh            text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
Caddyfile       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
