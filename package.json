{
  "name": "app-relay-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:endpoints": "tsx tests/test-endpoints/run.ts",
    "test:endpoints:typecheck": "tsc --noEmit -p tests/test-endpoints",
    "probe:endpoints": "tsx tests/test-endpoints/probe/run.ts",
    "download:artifacts": "tsx tests/test-endpoints/download-all.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.21.0",
    "pg": "^8.22.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  }
}
