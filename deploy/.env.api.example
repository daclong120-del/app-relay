# .env.api — biến của container `api`.
#
# Deploy trên VPS thì KHÔNG chép file này bằng tay: `deploy/bootstrap.sh` sinh
# ra .env.api với secret ngẫu nhiên và SUPABASE_SECRET_KEY ký đúng JWT_SECRET
# của Postgres self-host. File này chỉ để tra cứu và cho dev local.
#
# Bảng đầy đủ kèm ý nghĩa: docs/environment.md §2

NODE_ENV=production
PORT=5500

# Bốn biến dưới đây đi qua requireEnv() → throw NGAY LÚC BOOT nếu thiếu.
# Sai cấu hình thì container chết ngay thay vì chạy ngầm với fallback không an toàn.
# Sinh bằng lệnh, không gõ tay: openssl rand -hex 24
API_TOKEN=apr_live_xxxxxxxxx
WORKER_TOKEN=worker_live_xxxxxxxxx

# Supabase self-host trong compose: http://supabase:8000 và SUPABASE_SECRET_KEY
# là JWT HS256 mang claim role=service_role, ký bằng JWT_SECRET trong deploy/.env.
# Supabase Cloud: https://<ref>.supabase.co và khoá dạng sb_secret_...
SUPABASE_URL=http://supabase:8000
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx

# openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=secret_download_key_xxxx
DOWNLOAD_URL_TTL_SECONDS=600

ARTIFACT_DIR=/data/artifacts

# TTL tách đôi: APK nặng nên hết hạn sớm, phần nhẹ (listing, ảnh, metadata)
# giữ 30 ngày. 720 là giá trị mặc định trong code lẫn trong artifact-design.md.
APK_TTL_HOURS=6
ARTIFACT_TTL_HOURS=720

# Ngưỡng đĩa dự phòng trước khi dọn dẹp mạnh tay (10 GB).
ARTIFACT_MIN_FREE_BYTES=10737418240

# Thư mục phải nguội bao lâu mới bị coi là mồ côi và bị xoá.
ORPHAN_DIR_MIN_AGE_MINUTES=120

# Ân hạn trước khi xoá APK sau khi client tải xong.
DELETE_AFTER_DOWNLOAD_GRACE_MINUTES=10

# Job im lặng bao lâu thì reaper đưa về trạng thái kết thúc.
# PHẢI cao hơn hẳn lease 120 giây — đặt thấp thì reaper cướp job còn sống.
STUCK_JOB_GRACE_MINUTES=15
