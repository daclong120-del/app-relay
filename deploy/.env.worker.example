# .env.worker — biến của container `worker`.
#
# Deploy trên VPS thì KHÔNG chép file này bằng tay: `deploy/bootstrap.sh` sinh
# ra .env.worker và tự đồng bộ WORKER_TOKEN với .env.api.
#
# Bảng đầy đủ kèm ý nghĩa: docs/environment.md §3

WORKER_ID=worker_vps_01
WORKER_NAME=VPS Worker 01

RELAY_API_URL=http://api:5500/internal/v1

# PHẢI trùng tuyệt đối với WORKER_TOKEN trong .env.api. Lệch một ký tự thì
# worker vẫn online, heartbeat vẫn chạy, nhưng mọi lần claim job đều 403 và
# không job nào được nhận — lỗi im lặng nhất trong hệ này.
WORKER_TOKEN=worker_live_xxxxxxxxx

JAVA_HOME=/opt/java/openjdk
ANDROID_SDK_ROOT=/opt/android-sdk
ANDROID_AVD_HOME=/home/worker/.android/avd

ADB_PATH=/opt/android-sdk/platform-tools/adb
EMULATOR_PATH=/opt/android-sdk/emulator/emulator

ANDROID_AVD=chpay
WORK_DIR=/app/apps/worker/work

# Công tắc màn hình emulator.
#   on  — có cửa sổ emulator + noVNC ở 127.0.0.1:6080. CẦN khi đăng nhập Google
#         Play lần đầu, hoặc khi muốn nhìn tận mắt lúc gỡ lỗi.
#   off — emulator chạy -no-window, không bật openbox/x11vnc/novnc. Android vẫn
#         chạy đủ, job vẫn nhận bình thường, chỉ là không xem được màn hình.
#
# ĐỪNG sửa tay dòng này. Dùng script, nó dựng lại container luôn:
#   ./gui.sh          xem đang bật hay tắt
#   ./gui.sh off      tắt cho nhẹ CPU
#   ./gui.sh on       bật lại khi cần đăng nhập Play hoặc gỡ lỗi
#
# Tắt GUI KHÔNG làm mất phiên đăng nhập Google Play — phiên nằm trong volume
# worker-avd. Xem docs/deploy-vps.md §9.
WORKER_GUI=on

# `auto` requires /dev/kvm (run with -f compose.kvm.yaml). On a host without
# KVM set this to `off` — software emulation works but is far slower, so raise
# EMULATOR_BOOT_TIMEOUT accordingly.
EMULATOR_ACCEL=auto
EMULATOR_BOOT_TIMEOUT=600

# AVD sizing. The pixel_6 profile defaults to ~2G of userdata, which fills up
# once Play Store caches and a few hundred MB of APK land on it.
AVD_RAM_MB=3072
AVD_HEAP_MB=512
AVD_DATA_SIZE=12G
AVD_SDCARD_SIZE=2G

POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=20000
