# Node dependencies
node_modules/

# Environment & sensitive credential files
.env
.env.*
!.env.example
!.env.*.example
*.info
new_setup/*.info

# Build output
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Work & Artifact directories
# Anchored with a leading slash: an unanchored `artifacts/` also matches source
# directories like apps/api/src/modules/artifacts/, silently excluding real code
# from the repository.
apps/worker/work/
apps/api/data/
/artifacts/
apps/api/artifacts/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Seed AVD — ~2.5 GB nhị phân, và bên trong là thông tin đăng nhập Google
# (accounts_ce.db, GSF ID, auth token nằm trong userdata-qemu.img.qcow2).
# Sinh ra bởi deploy/capture-avd-seed.sh, nướng vào image lúc build.
# Giữ .gitkeep để thư mục vẫn tồn tại — Dockerfile COPY nó, thiếu là hỏng build.
/avd-seed/*
!/avd-seed/.gitkeep

# Local tools & SDKs
tools/
cmdline-tools/
# Output cua bo test endpoint (tests/test-endpoints)
/work/
